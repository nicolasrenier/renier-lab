{
  // Static-asset-only Worker: no server code, Cloudflare just serves site/.
  // Deployed by Workers Builds on every push to main (`npx wrangler deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "renier-lab",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site/",

    // Serve site/404.html with a real 404 status for unknown paths.
    "not_found_handling": "404-page",

    // /research.html and /research both resolve; folder indexes keep their slash.
    "html_handling": "auto-trailing-slash"
  }
}
